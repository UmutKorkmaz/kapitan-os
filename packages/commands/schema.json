{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kapitan.os/schemas/commands/v1.0.0",
  "title": "KAPiTaN OS commands.json",
  "description": "JSON Schema for the canonical command catalog consumed by website, shell, and CI.",
  "type": "object",
  "required": ["version", "locale", "source", "groups", "commands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(_[A-Z]{2})?$"
    },
    "source": { "type": "string", "minLength": 1 },
    "groups": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/definitions/group" }
    },
    "commands": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "items": { "$ref": "#/definitions/command" }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totalCommands": { "type": "integer", "const": 66 },
        "status": { "type": "string" },
        "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  "definitions": {
    "group": {
      "type": "object",
      "required": ["key", "label", "glyph", "order"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "enum": ["dosya", "sistem", "ag", "paket", "metin", "git", "ai"]
        },
        "label": { "type": "string", "minLength": 1 },
        "glyph": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1, "maximum": 7 }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "id",
        "posix",
        "kapitan",
        "short",
        "description",
        "group",
        "phase"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "posix": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "kapitan": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zçğıöşü0-9]+$"
        },
        "short": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4,
          "pattern": "^[a-zçğıöşüA-ZÇĞİÖŞÜ0-9]+$"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 120 },
        "group": {
          "type": "string",
          "enum": ["dosya", "sistem", "ag", "paket", "metin", "git", "ai"]
        },
        "phase": { "type": "integer", "minimum": 1 },
        "implemented": { "type": "boolean" },
        "replaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kapitan": { "type": "string" },
            "short": { "type": "string" },
            "reason": { "type": "string" }
          }
        },
        "collision_warnings": {
          "type": "array",
          "items": { "$ref": "#/definitions/collisionWarning" }
        }
      }
    },
    "collisionWarning": {
      "type": "object",
      "required": ["type", "conflicts_with", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["posix_binary", "legacy_alias", "short_ambiguity", "cross_group"]
        },
        "conflicts_with": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "message": { "type": "string" }
      }
    }
  }
}