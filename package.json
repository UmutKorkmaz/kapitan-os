{
  "name": "kapitan-os",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "KAPiTaN OS — Türkçe komut katmanlı açık kaynak Linux dağıtımı",
  "license": "GPL-3.0-only",
  "workspaces": [
    "website",
    "packages/*"
  ],
  "scripts": {
    "validate:commands": "node packages/commands/scripts/validate.mjs",
    "test:shell": "bats packages/kapitan-sh/tests",
    "build:website": "npm run build -w website",
    "sync:iso-assets": "bash build/scripts/sync-image-assets.sh",
    "build:iso": "bash build/live-build/build.sh",
    "build:live": "bash build/live-build/build.sh",
    "dry-run:iso": "bash build/live-build/build.sh --dry-run",
    "qemu:smoke": "bash build/scripts/qemu-smoke.sh",
    "ci": "npm run validate:commands && npm run test:shell && npm run build:website"
  },
  "engines": {
    "node": ">=20"
  }
}