# KAPiTaN OS — minimal chroot packages (Phase 1 alpha skeleton)
# See: docs/KAPiTaN OS BUILD PLAN.md §3.5.3

# Locale support (tr_TR.UTF-8 generated in chroot hook)
locales

# Core shell utilities
bash
coreutils
jq

# Git — collision test: `git` must not be aliased to `gir`
git

# Smoke-test utilities
sudo
curl

# Live system boot infrastructure (usually pulled by live-build; explicit for skeleton)
live-boot
live-config
live-config-systemd

# Hardware enablement — Wi-Fi/network + CPU microcode so the ISO actually works
# on real laptops (Debian live ships these by default; non-free-firmware enabled
# in auto/config). Without firmware-iwlwifi/realtek/atheros/brcm80211 most laptop
# Wi-Fi is dead — fatal for the Bar "old hardware" target.
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
intel-microcode
amd64-microcode