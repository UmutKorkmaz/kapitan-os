#!/bin/sh
# KAPiTaN OS — Phase 1 alpha live-build configuration (Debian 12 amd64)
# Invoked by: lb config  (reads auto/config)
# See: build/README.md, docs/KAPiTaN OS BUILD PLAN.md §3.5.3

set -e

# --- Identity & target ---
lb config noauto \
  --mode debian \
  --system live \
  --distribution bookworm \
  --architectures amd64 \
  --linux-flavours amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --bootappend-live "boot=live components quiet locales=tr_TR.UTF-8 keyboard-layouts=tr console=ttyS0,115200n8" \
  --iso-application "KAPiTaN OS" \
  --iso-volume "KAPITAN_ALPHA" \
  --memtest none \
  --debian-installer false \
  --win32-loader false \
  --binary-images iso-hybrid \
  --bootloader grub-pc \
  --security false

# --- Mirror (override via KAPITAN_MIRROR env) ---
: "${KAPITAN_MIRROR:=http://deb.debian.org/debian}"
lb config noauto --mirror-bootstrap "${KAPITAN_MIRROR}"
lb config noauto --mirror-chroot "${KAPITAN_MIRROR}"
lb config noauto --mirror-binary "${KAPITAN_MIRROR}"

# Chroot hook: config/hooks/normal/0100-kapitan.hook.chroot
# Image assets: build/scripts/sync-image-assets.sh → config/includes.chroot