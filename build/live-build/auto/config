#!/usr/bin/env bash
# KAPiTaN OS — live-build configuration (Debian 12 amd64)
# Invoked by: lb config  (reads auto/config)
# See: build/README.md, docs/KAPiTaN OS BUILD PLAN.md §3.5.3

set -e

: "${KAPITAN_MIRROR:=http://deb.debian.org/debian}"
KAPITAN_EDITION="${KAPITAN_EDITION:-bar}"

if [[ ! "$KAPITAN_EDITION" =~ ^(bar|ofis|gelistirici)$ ]]; then
  echo "Error: KAPITAN_EDITION must be bar, ofis, or gelistirici" >&2
  exit 2
fi

KAPITAN_EDITION_UPPER="$(printf '%s' "${KAPITAN_EDITION}" | tr '[:lower:]' '[:upper:]')"

# --- Identity & target (mirrors in same invocation — lb ignores late mirror overrides) ---
lb config noauto \
  --mode debian \
  --system live \
  --distribution bookworm \
  --architectures amd64 \
  --linux-flavours amd64 \
  --linux-packages linux-image \
  --archive-areas "main contrib non-free non-free-firmware" \
  --bootappend-live "boot=live components quiet locales=tr_TR.UTF-8 keyboard-layouts=tr console=tty0 console=ttyS0,115200n8 username=kapitan hostname=kapitan" \
  --iso-application "KAPiTaN OS — ${KAPITAN_EDITION}" \
  --iso-volume "KAPITAN_${KAPITAN_EDITION_UPPER}" \
  --memtest none \
  --debian-installer false \
  --win32-loader false \
  --binary-images iso-hybrid \
  --bootloaders syslinux,grub-efi \
  --security false \
  --debootstrap-options "--include=ca-certificates" \
  --mirror-bootstrap "${KAPITAN_MIRROR}" \
  --mirror-chroot "${KAPITAN_MIRROR}" \
  --mirror-binary "${KAPITAN_MIRROR}"

# Chroot hook: config/hooks/normal/0100-kapitan.hook.chroot
# Image assets: build/scripts/sync-image-assets.sh → config/includes.chroot
