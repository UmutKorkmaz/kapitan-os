FROM debian:bookworm

RUN apt-get update && apt-get install -y \
    live-build \
    debootstrap \
    jq \
    curl \
    ca-certificates \
    git \
    nodejs \
    npm \
    sudo \
    xorriso \
    grub-efi-amd64-bin \
    grub-pc-bin \
    syslinux-common \
    isolinux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
